{
  "name": "Auditera — עדכון פרטי לקוח (Login + Profile Update)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": {
          "name": "Auditera Login Hook"
        }
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "routes": [
        {
          "label": "profile_update",
          "filter": {
            "name": "עדכון פרטים",
            "conditions": [
              [ { "a": "{{1.event}}", "b": "profile_update", "o": "text:equal" } ]
            ]
          },
          "flow": [
            {
              "id": 3,
              "module": "airtable:searchRecords",
              "version": 3,
              "parameters": {
                "base": "YOUR_AIRTABLE_BASE_ID",
                "table": "Users"
              },
              "mapper": {
                "formula": "({Email} = '{{1.email}}')",
                "maxRecords": 1
              },
              "metadata": {
                "designer": { "x": 400, "y": -150 },
                "expect": [
                  { "name": "formula",   "label": "Filter by formula", "type": "text" },
                  { "name": "maxRecords","label": "Max records",       "type": "number" }
                ]
              }
            },
            {
              "id": 4,
              "module": "airtable:updateRecord",
              "version": 3,
              "parameters": {
                "base": "YOUR_AIRTABLE_BASE_ID",
                "table": "Users"
              },
              "mapper": {
                "id": "{{3.id}}",
                "fields": {
                  "Plan":           "{{1.plan}}",
                  "Name":           "{{1.name}}",
                  "License Quota":  "{{1.license_quota}}",
                  "CPA Name":       "{{1.cpa_name}}",
                  "CPA License":    "{{1.cpa_license}}",
                  "CPA Firm":       "{{1.cpa_firm}}",
                  "CPA Address":    "{{1.cpa_address}}",
                  "Analysis Count": "{{1.analysis_count}}",
                  "Changed Fields": "{{join(1.changed_fields; ', ')}}",
                  "Last Updated":   "{{formatDate(now; 'YYYY-MM-DD HH:mm:ss')}}"
                }
              },
              "metadata": {
                "designer": { "x": 700, "y": -150 }
              }
            }
          ]
        },
        {
          "label": "login",
          "filter": {
            "name": "כניסה רגילה",
            "conditions": [
              [ { "a": "{{1.event}}", "b": "login", "o": "text:equal" } ]
            ]
          },
          "flow": [
            {
              "id": 5,
              "module": "airtable:searchRecords",
              "version": 3,
              "parameters": {
                "base": "YOUR_AIRTABLE_BASE_ID",
                "table": "Users"
              },
              "mapper": {
                "formula": "({Email} = '{{1.email}}')",
                "maxRecords": 1
              },
              "metadata": {
                "designer": { "x": 400, "y": 150 }
              }
            },
            {
              "id": 6,
              "module": "airtable:updateRecord",
              "version": 3,
              "parameters": {
                "base": "YOUR_AIRTABLE_BASE_ID",
                "table": "Users"
              },
              "mapper": {
                "id": "{{5.id}}",
                "fields": {
                  "Last Login":     "{{1.login_at}}",
                  "Plan":           "{{1.plan}}",
                  "Analysis Count": "{{1.analysis_count}}",
                  "Days Since Reg": "{{1.days_since_reg}}"
                }
              },
              "metadata": {
                "designer": { "x": 700, "y": 150 }
              }
            }
          ]
        }
      ],
      "metadata": {
        "designer": { "x": 200, "y": 0 }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false
    },
    "designer": {
      "orphans": []
    }
  }
}
